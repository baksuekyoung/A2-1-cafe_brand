# 이 파일을 .env 로 복사한 뒤 키를 채웁니다.
#   cp .env.example .env
# .env 는 .gitignore 에 있어 GitHub 에 올라가지 않습니다.

# --- 코디세이 공개 API ---------------------------------------------------
#
# 소속 기관 키로 정산되므로 개인 결제분을 쓰지 않습니다.
# 텍스트(네이밍·슬로건·스토리·컬러)와 이미지(로고)를 이 키 하나로 처리합니다.
#
# 발급: https://usr.codyssey.kr/daejeon/public-api-console
#       MY > API 키 관리 > 키 발급
#
# ⚠️ 호환 방식을 **OpenAI** 로 발급받으세요.
#    Anthropic 호환 키는 채팅에서 거부됩니다 (HTTP 403).
#
# ⚠️ 키 값은 발급 직후 한 번만 보입니다. 그 자리에서 복사해 두세요.
CODYSSEY_OPENAI_KEY=
CODYSSEY_BASE_URL=https://copa.codyssey.kr
