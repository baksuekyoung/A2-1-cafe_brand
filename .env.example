# 이 파일을 .env 로 복사한 뒤 본인 키를 채웁니다.
#   cp .env.example .env
# .env 는 .gitignore 에 있어 GitHub 에 올라가지 않습니다.
#
# 아래 중 하나만 있으면 됩니다.
# 공급자를 코디세이 → OpenAI → Gemini 순으로 시도하고, 되는 것을 씁니다.
# 이미지는 그 뒤에 Pollinations(키 불필요)까지 이어집니다.

# --- 코디세이 공개 API (권장) ------------------------------------------
#
# 소속 기관 키로 정산되므로 개인 결제분을 쓰지 않습니다.
# 텍스트와 이미지를 이 키 하나로 처리합니다.
#
# 발급: https://usr.codyssey.kr/daejeon/public-api-console
#       MY > API 키 관리 > 키 발급
#
# ⚠️ 호환 방식을 **OpenAI** 로 발급받으세요.
#    Anthropic 호환 키는 채팅에서 거부됩니다 (HTTP 403).
#    이미지는 둘 다 되지만, 하나로 끝내는 편이 낫습니다.
#
# ⚠️ 키 값은 발급 직후 한 번만 보입니다. 그 자리에서 복사해 두세요.
CODYSSEY_OPENAI_KEY=
CODYSSEY_BASE_URL=https://copa.codyssey.kr

# --- 개인 키 (코디세이가 없거나 한도가 떨어졌을 때) --------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
